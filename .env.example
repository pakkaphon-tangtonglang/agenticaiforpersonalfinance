# =============================================================================
# Personal Finance AI - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Personal Finance AI
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (Development)
DB_URL=sqlite:///./finance_ai.db

# PostgreSQL (Production)
# DB_URL=postgresql://user:password@localhost:5432/finance_ai
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Anthropic Claude (Primary)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-opus-4  # claude-opus-4, claude-sonnet-4, claude-haiku-4
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7

# OpenAI (Alternative - Not yet implemented)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# RAG (Retrieval Augmented Generation)
# -----------------------------------------------------------------------------
RAG_COLLECTION_NAME=finance_knowledge
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_METADATA={"hnsw:space": "cosine"}

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# External APIs (Optional)
# -----------------------------------------------------------------------------
# Stock Market Data
SET_API_KEY=your_set_api_key_here  # Thailand Stock Exchange API
YAHOO_FINANCE_ENABLED=true

# Mutual Fund Data
AIMC_API_KEY=your_aimc_api_key_here  # Thai Asset Management Association

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for JWT tokens, session encryption, etc.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Password hashing
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_HASH_ROUNDS=12

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Encryption (SQLCipher)
DB_ENCRYPTION_KEY=your-database-encryption-key-here

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
TEST_DB_URL=sqlite:///:memory:
TEST_LLM_MOCK=true  # Mock LLM calls in tests to save costs

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=json  # json or text

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_TAX_AGENT=true
FEATURE_INVESTMENT_AGENT=false  # Coming soon
FEATURE_EXPENSE_AGENT=false  # Coming soon
FEATURE_PLANNING_AGENT=false  # Coming soon
FEATURE_RAG=false  # Coming soon

# -----------------------------------------------------------------------------
# Performance
# -----------------------------------------------------------------------------
# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Query Optimization
DB_QUERY_TIMEOUT_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable development features
DEV_AUTO_RELOAD=true
DEV_DEBUG_TOOLBAR=true
DEV_PROFILING=false

# Pre-commit hooks
PRE_COMMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Thai-Specific Settings
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=THB
TAX_YEAR=2024
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_LANGUAGE=th

# Tax Calculation Settings
TAX_PERSONAL_ALLOWANCE=60000
TAX_SPOUSE_ALLOWANCE=60000
TAX_CHILD_ALLOWANCE=30000
TAX_PARENT_ALLOWANCE=30000

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Temporary file cleanup
TEMP_FILE_CLEANUP_DAYS=7

# User uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=pdf,csv,xlsx

# Notifications (Future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@financeai.com
SMTP_USE_TLS=true
