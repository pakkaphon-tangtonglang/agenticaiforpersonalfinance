# =============================================================================
# Personal Finance AI - Environment Variables
# =============================================================================
# วิธีใช้:
#   1. คัดลอกไฟล์นี้เป็น .env  →  cp .env.example .env
#   2. แก้ไขค่าในไฟล์ .env ให้ตรงกับการตั้งค่าของคุณ
#   3. อย่า commit ไฟล์ .env ลง git เด็ดขาด! (มี API keys อยู่)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# ชื่อแอป (แสดงใน UI และ log)
APP_NAME=Personal Finance AI

# สภาพแวดล้อม: development | staging | production
# development = เปิด debug, log ละเอียด
# production  = ปิด debug, log เฉพาะ warning ขึ้นไป
APP_ENV=development

# เปิด/ปิด debug mode (true/false)
# เปิดแล้วจะเห็น error details, stack trace ใน UI
DEBUG=true

# ระดับ log: DEBUG | INFO | WARNING | ERROR | CRITICAL
# DEBUG   = ทุกอย่าง (LLM request/response, DB queries)
# INFO    = เหตุการณ์สำคัญ (agent calls, tool usage)
# WARNING = สิ่งที่อาจเป็นปัญหา
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# รองรับ SQLite (dev) และ PostgreSQL (production)
#
# SQLite — ง่าย ไม่ต้อง setup อะไร ไฟล์จะถูกสร้างอัตโนมัติ
DB_URL=sqlite:///./finance_ai.db
#
# PostgreSQL — สำหรับ production ที่ต้องการ concurrent access
# DB_URL=postgresql://user:password@localhost:5432/finance_ai

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# เลือก provider ที่จะใช้: google | ollama | openrouter
#
#   google      = Google Gemini API (ต้องมี GOOGLE_API_KEY)
#                 ข้อดี: ฟรี tier มี quota เยอะ, รองรับภาษาไทยดี
#
#   ollama      = รัน LLM บนเครื่องตัวเอง (ต้องติดตั้ง Ollama ก่อน)
#                 ข้อดี: ฟรี 100%, ข้อมูลไม่ออกนอกเครื่อง
#                 ข้อเสีย: ต้องมี GPU, ช้ากว่า API
#
#   openrouter  = เข้าถึง 400+ โมเดลผ่าน API เดียว (ต้องมี OPENROUTER_API_KEY)
#                 ข้อดี: เลือกโมเดลได้หลากหลาย, ราคาถูก
#                 ข้อเสีย: ต้องเติมเงิน (แต่ถูกมาก)
#
LLM_PROVIDER=google

# จำนวน tokens สูงสุดต่อ response (1-8000)
# ยิ่งมาก = ตอบได้ยาวขึ้น แต่เสียค่า API มากขึ้น
# แนะนำ: 4000 สำหรับการใช้งานทั่วไป
LLM_MAX_TOKENS=4000

# ความ "สร้างสรรค์" ของ AI (0.0-1.0)
# 0.0 = ตอบตรงๆ เป๊ะๆ เหมาะกับการคำนวณภาษี
# 0.7 = สมดุลระหว่างความแม่นยำและความหลากหลาย (แนะนำ)
# 1.0 = สร้างสรรค์สูงสุด (อาจไม่แม่นยำ)
LLM_TEMPERATURE=0.7

# ========================
# Google Gemini Configuration
# ========================
# สมัคร API key ฟรีได้ที่: https://aistudio.google.com/apikey
# Free tier: 60 requests/minute, เพียงพอสำหรับ development
GOOGLE_API_KEY=your-google-api-key-here

# โมเดลที่จะใช้ (ดูรายชื่อได้ที่ https://ai.google.dev/gemini-api/docs/models)
# gemini-2.5-flash   = เร็ว + ถูก (แนะนำ)
# gemini-2.5-pro     = ฉลาดกว่า แต่ช้าและแพงกว่า
GOOGLE_MODEL=gemini-2.5-flash

# ========================
# OLLAMA Configuration (Local or Ollama Cloud)
# ========================
# รองรับทั้ง:
#   - Ollama บนเครื่องตัวเอง: https://ollama.com/download
#   - Ollama Cloud: https://ollama.com/search?c=cloud (ต้องมี API key)
#
# OLLAMA_BASE_URL = URL ของ Ollama server
#   Localhost     = http://localhost:11434
#   Ollama Cloud  = https://ollama.com
#
# OLLAMA_MODEL = ชื่อโมเดล สำหรับ chat/agent (text-only เช่น THALLE / deepseek-v4-flash)
#   หมายเหตุ: OLLAMA_* นี่ใช้กับ chat agent เท่านั้น
#   สำหรับ OCR/scan เอกสารให้ดูบล็อก OCR_* ด้านล่าง (ใช้โมเดล vision แยก)
#
# สร้าง API key สำหรับ Ollama Cloud: https://ollama.com/settings/keys
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=deepseek-v4-flash
# OLLAMA_API_KEY=your-ollama-api-key-here

# ========================
# OCR Configuration (vision model สำหรับสแกนเอกสาร)
# ========================
# แยกจาก LLM_PROVIDER เพื่อให้ OCR ใช้โมเดล vision (รองรับภาพ) โดยไม่กระทบ chat agent
# ใช้กับ endpoint POST /upload/receipt (สแกนใบเสร็จ/สลิป/ใบกำกับภาษี)
#
# OCR_PROVIDER = เลือก provider สำหรับ OCR: google | ollama
# OCR_MODEL    = ชื่อโมเดล vision (ต้องรองรับภาพ, text-only ใช้ไม่ได้)
#   ชื่อต้องตรงกับ https://ollama.com/api/tags ทุกตัว (เรียกผ่าน Cloud API ตรงๆ ที่ https://ollama.com
#   ห้ามใช้ suffix :cloud เพราะนั่นคือ alias ของ local-Ollama-proxy เท่านั้น)
#   โมเดลแนะนำสำหรับ OCR ใบเสร็จ/สลิปภาษาไทย (เรียงตามความเหมาะสม):
#     gemma4:31b    — Cloud vision, Text+Image, Low usage, ออกแบบมาเพื่อ OCR/อ่านเอกสาร (แนะนำ!)
#     qwen3.5:397b  — Cloud vision, Text+Image, Medium usage, OCR/มัลติภาษาแข็งแกร่ง (สำหรับรูปคุณภาพต่ำ)
#   หมายเหตุ: qwen3.5:27b / qwen3.5:9b / gemma4:12b เป็น tag สำหรับรัน local เท่านั้น
#   (ไม่มีใน Ollama Cloud) หากจะรัน local ให้ตั้ง OCR_BASE_URL=http://localhost:11434,
#   เคลียร์ OCR_API_KEY แล้ว `ollama pull <model>` ก่อน
# OCR_API_KEY  = API key ของ OCR provider
#   ollama  = Ollama Cloud key (https://ollama.com/settings/keys)
#   google  = Google API key (ใช้สำหรับ OCR โดยเฉพาะ ไม่ต้องใช้ GOOGLE_API_KEY)
# OCR_BASE_URL = base URL ของ OCR provider (Ollama Cloud = https://ollama.com)
OCR_PROVIDER=ollama
OCR_MODEL=gemma4:31b
OCR_API_KEY=your-ocr-api-key-here
# OCR_BASE_URL=https://ollama.com
# --- ปรับแต่งความเร็ว/คุณภาพ OCR (ค่าเริ่มต้นเน้นความเร็ว) ---
# OCR_TEMPERATURE=0.0        # 0 = deterministic (เร็ว+คงที่), ค่าสูงขึ้นจะช้าลงเล็กน้อย
# OCR_MAX_TOKENS=2000        # จำกัด output ให้สั้นตามความจำเป็น (JSON array สั้นๆ พอ)
# OCR_TIMEOUT=120.0         # วินาที — เกินเวลานี้จะคืน 504 ให้ผู้ใช้แทนค้าง
# OCR_MAX_IMAGE_EDGE=1568   # px — รูปใหญ่กว่านี้จะถูกย่อขนาดก่อนส่งให้โมเดล (ตัด latency ได้มาก)

# ========================
# OpenRouter Configuration
# ========================
# สมัครและเติมเงินได้ที่: https://openrouter.ai/keys
# ใช้ API เดียวเข้าถึงโมเดลจาก OpenAI, Anthropic, Google, Meta ฯลฯ
#
# โมเดลแนะนำ (เรียงตามราคาถูก → แพง):
#   deepseek/deepseek-chat-v3-0324       — $0.27/1M tokens ถูกสุด+ฉลาด (แนะนำ!)
#   google/gemini-2.5-flash-preview      — $0.15/1M tokens เร็ว+ถูก
#   openai/gpt-4o-mini                   — $0.15/1M tokens สมดุลดี
#   anthropic/claude-haiku-4             — $0.80/1M tokens ภาษาไทยดี
#   anthropic/claude-sonnet-4            — $3.00/1M tokens ฉลาดมาก
#
# ดูราคาและโมเดลทั้งหมด: https://openrouter.ai/models
#
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# -----------------------------------------------------------------------------
# RAG (Retrieval Augmented Generation) — ระบบค้นหาความรู้การเงิน
# -----------------------------------------------------------------------------
# RAG ใช้ค้นหาข้อมูลจาก knowledge base (docs/knowledge_base/)
# แล้วส่งให้ AI ใช้ประกอบการตอบคำถาม
#
# Embedding Provider: วิธีแปลงข้อความเป็น vector สำหรับค้นหา
#   google                = ใช้ Google Embedding API (ต้องมี GOOGLE_API_KEY)
#   sentence_transformers = รันบนเครื่อง (ไม่ต้องใช้ API, แต่ช้ากว่า)
RAG_EMBEDDING_PROVIDER=google

# Google Embedding Model (ใช้กับ RAG_EMBEDDING_PROVIDER=google)
RAG_EMBEDDING_MODEL=models/embedding-001

# Sentence Transformers Model (ใช้กับ RAG_EMBEDDING_PROVIDER=sentence_transformers)
# รองรับภาษาไทย, รันบนเครื่อง ไม่ต้องใช้ API
RAG_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB — ฐานข้อมูล vector สำหรับเก็บ embeddings
# โฟลเดอร์เก็บข้อมูล (สร้างอัตโนมัติ)
RAG_CHROMA_PERSIST_DIRECTORY=./data/chroma_db
# ชื่อ collection (ปกติไม่ต้องเปลี่ยน)
RAG_CHROMA_COLLECTION_NAME=finance_knowledge

# Text Splitting — วิธีตัดเอกสารเป็นชิ้นเล็กๆ
# CHUNK_SIZE    = ขนาดแต่ละชิ้น (ตัวอักษร) — ใหญ่ = context เยอะ แต่ค้นหาช้า
# CHUNK_OVERLAP = ส่วนทับซ้อนระหว่างชิ้น — ป้องกันข้อมูลหายตรงรอยตัด
# SEARCH_TOP_K  = จำนวนผลลัพธ์ที่ดึงมาให้ AI — มาก = ข้อมูลเยอะ แต่ช้าขึ้น
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SEARCH_TOP_K=3

# โฟลเดอร์เก็บไฟล์ knowledge base (.md files)
RAG_KNOWLEDGE_BASE_DIRECTORY=docs/knowledge_base

# -----------------------------------------------------------------------------
# API Configuration (FastAPI server)
# -----------------------------------------------------------------------------
# Host และ Port สำหรับ API server
# 127.0.0.1 = เข้าถึงได้เฉพาะเครื่องนี้
# 0.0.0.0   = เข้าถึงได้จากเครื่องอื่นในเครือข่าย (ระวังเรื่อง security)
API_HOST=127.0.0.1
API_PORT=8000

# -----------------------------------------------------------------------------
# LangSmith Tracing (Optional) — ระบบ debug/monitor LLM calls
# -----------------------------------------------------------------------------
# สมัครฟรีได้ที่: https://smith.langchain.com
# ช่วย debug ได้มาก — เห็น prompt, response, latency ของทุก LLM call
# แนะนำเปิดตอน development
#
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=finance-ai
