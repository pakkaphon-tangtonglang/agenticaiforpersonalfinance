# =============================================================================
# Personal Finance AI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Personal Finance AI
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (Development)
DB_URL=sqlite:///./finance_ai.db

# PostgreSQL (Production)
# DB_URL=postgresql://user:password@localhost:5432/finance_ai

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
LLM_PROVIDER=google  # google, ollama, openrouter
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# OLLAMA / THALLE (Local LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=THALLE

# OpenRouter (400+ models via one API — cheap + smart)
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# Other models: google/gemini-2.5-flash-preview, openai/gpt-4o-mini, anthropic/claude-haiku-4

# -----------------------------------------------------------------------------
# RAG (Retrieval Augmented Generation)
# -----------------------------------------------------------------------------
RAG_EMBEDDING_PROVIDER=google  # google, sentence_transformers
RAG_EMBEDDING_MODEL=models/embedding-001
RAG_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHROMA_PERSIST_DIRECTORY=./data/chroma_db
RAG_CHROMA_COLLECTION_NAME=finance_knowledge
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SEARCH_TOP_K=3
RAG_KNOWLEDGE_BASE_DIRECTORY=docs/knowledge_base

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# -----------------------------------------------------------------------------
# LangSmith Tracing (Optional)
# -----------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=finance-ai
